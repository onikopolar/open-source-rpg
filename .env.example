# ─── Ambiente ───────────────────────────────────────────────────
NODE_ENV=development

# ─── Banco de Dados (PostgreSQL) ────────────────────────────────
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="postgres://postgres:SUA_SENHA@localhost:5432/open_source_rpg"

# ─── Servidor ───────────────────────────────────────────────────
PORT=3000

# ─── NextAuth (opcional) ────────────────────────────────────────
# NEXTAUTH_URL=http://localhost:3000

# ─── Cloudflare Tunnel (opcional, para expor localmente) ────────
# Obtenha seu token em: https://dash.cloudflare.com → Zero Trust → Tunnels
# CLOUDFLARE_TUNNEL_TOKEN=eyJh...seu-token-aqui