{
  "name": "open-source-rpg-app",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:cloudflare": "cloudflared tunnel run",
    "build": "prisma generate && prisma migrate deploy && npm run check && next build",
    "build:dev": "prisma generate && prisma db push && npm run check && next build",
    "start": "node src/server.js",
    "check": "tsc --noEmit",
    "test:p2p": "npx tsx scripts/test-p2p.ts",
    "test:p2p:full": "npx tsx scripts/test-p2p-completo.ts",
    "test": "npm run check && npm run test:p2p && npm run test:p2p:full",
    "lint": "next lint",
    "railway-setup": "prisma db push && prisma generate",
    "db-migrate": "prisma migrate dev",
    "db-seed-yearzero": "node src/prisma/seed-yearzero.js",
    "db-seed-feiticos": "node src/prisma/seed-feiticos.js",
    "db-studio": "prisma studio",
    "db-reset": "prisma migrate reset"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma",
    "seed": "node src/prisma/seed.js"
  },
  "dependencies": {
    "@emotion/react": "^11.4.1",
    "@emotion/server": "^11.4.0",
    "@emotion/styled": "^11.3.0",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.0.3",
    "@mui/styles": "^5.0.1",
    "@prisma/client": "^6.18.0",
    "axios": "^1.12.2",
    "copy-to-clipboard": "^3.3.1",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "formidable": "^3.5.4",
    "formik": "^2.2.9",
    "js-queue": "^2.0.2",
    "multer": "^2.0.2",
    "next": "^14.2.35",
    "prisma": "^6.18.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-easy-crop": "^5.5.6",
    "react-transition-group": "^4.4.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.3.1",
    "socket.io-client": "^4.3.2",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "19.2.17",
    "concurrently": "^8.2.0",
    "eslint": "7.32.0",
    "eslint-config-next": "14.2.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
